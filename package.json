{
  "name": "healthcare",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:e2e": "nuxt dev --port 3100",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:setup": "supabase start && supabase db reset && docker exec -i supabase_db_erp-healthcare psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/seed_dummy.sql && docker exec -i supabase_db_erp-healthcare psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/seed_e2e.sql"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fontsource/public-sans": "^5.2.7",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@fullcalendar/vue3": "^6.1.20",
    "@mdi/font": "^7.4.47",
    "@pinia/nuxt": "^0.11.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.0",
    "@vueuse/core": "^14.3.0",
    "animejs": "^4.5.0",
    "apexcharts": "^5.15.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.5",
