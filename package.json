    "pinia": "^3.0.4",
    "resend": "^6.14.0",
    "sortablejs": "^1.15.7",
    "stripe": "^22.3.0",
    "swiper": "^14.0.1",
    "vue": "^3.5.35",
    "vue3-apexcharts": "^1.11.1",
    "vue3-perfect-scrollbar": "^2.0.0",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
