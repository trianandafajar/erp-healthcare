    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.0.0",
    "@types/sortablejs": "^1.15.9",
    "happy-dom": "^20.11.2",
    "sass": "^1.77.1",
    "tailwind-bootstrap-grid": "^7.0.0",
